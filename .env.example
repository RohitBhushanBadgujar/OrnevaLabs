# ==============================================================================
# ORNEVA LABS - ENVIRONMENT CONFIGURATION TEMPLATE
# "The Origin of New Possibilities"
# "Learn something useful. Build something real."
# ==============================================================================

# Core Brand & Identity
ORNEVA_APP_NAME="Orneva Labs"
ORNEVA_TAGLINE="The Origin of New Possibilities"
ORNEVA_POSITIONING="Learn something useful. Build something real."

# UPI Payment Gateway Details
# Payments sent to this UPI ID require manual UTR & screenshot verification by admin
ORNEVA_UPI_ID="9172750062@fam"
ORNEVA_PAYEE_NAME="Orneva Labs"
ORNEVA_WHATSAPP_NUMBER="9172750062"

# Backend REST API Connection
# Leave empty to utilize the zero-config client-side edge database engine.
# To connect to production Google Sheets, deploy backend/Code.gs as a Web App and paste the URL below.
ORNEVA_API_URL=""
# Example: ORNEVA_API_URL="https://script.google.com/macros/s/AKfycb.../exec"

# Administration Bootstrap Credentials
# Configure in Google Apps Script -> Project Settings -> Script Properties before running setupOrnevaDatabase()
ORNEVA_DEFAULT_ADMIN_EMAIL="admin@ornevalabs.com"
ORNEVA_INITIAL_ADMIN_PASSWORD="<set-strong-initial-admin-password>"
